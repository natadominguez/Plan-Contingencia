# --- x402 / Monad ---
# Wallet que recibe los micropagos (USDC en Monad testnet)
PAY_TO_ADDRESS=0xYourTreasuryWallet
# Facilitador oficial de Monad (solo x402 v2)
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# eip155:10143 = Monad testnet | eip155:143 = Monad mainnet
MONAD_NETWORK=eip155:10143
# USDC testnet en Monad (mainnet viene integrado en el SDK)
MONAD_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# --- Attestation on-chain ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Clave privada de la wallet que paga gas para registrar hashes (testnet!)
ATTESTER_PRIVATE_KEY=
# Direccion del PlanRegistry desplegado (ver contracts/PlanRegistry.sol)
PLAN_REGISTRY_ADDRESS=

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Agente monitor ---
# Intervalo de chequeo de actualizaciones normativas (segundos)
MONITOR_INTERVAL_SECONDS=60
